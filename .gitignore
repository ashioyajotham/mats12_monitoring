!data/raw/procedural_math_certificates_v1.jsonl
!data/raw/procedural_math_candidates_v1.manifest.json
!data/raw/procedural_math_pilot_v1.jsonl
!data/raw/procedural_math_pilot_v1.certificates.jsonl
