!data/raw/calibration_questions.manifest.json
!data/raw/math_questions.jsonl
!data/raw/math_questions.manifest.json
!data/generated/.gitkeep
!data/reviewed/.gitkeep

# Generated result artifacts
results/figures/*
results/*.json
results/*.jsonl
